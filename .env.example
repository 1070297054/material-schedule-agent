# 离线 Mock 无需任何环境变量。可使用 --env-file .env 显式加载，环境变量优先。
# 真实模型使用支持 Responses API function calling 的模型。
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选：本机 HTTP 访问口令（至少 24 个 ASCII 字符）；留空则每次启动自动生成。
# 与模型 API 密钥不同，不提交真实口令。
SCHEDULE_API_TOKEN=
